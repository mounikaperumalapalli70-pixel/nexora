# ============================================================
# NEXORA PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or configure in your cloud host dashboard
# NEVER commit real API keys or client secrets to version control.
# ============================================================

# Application Environment ('development' or 'production')
ENVIRONMENT=production

# Secret key for encrypting and signing session cookies (generate a random 32+ char string)
SESSION_SECRET_KEY=your_strong_random_secret_session_key_32chars_min

# Frontend Deployment URL (e.g. https://nexora.vercel.app)
FRONTEND_URL=https://your-nexora-app.vercel.app

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://your-nexora-app.vercel.app,http://localhost:8000

# ============================================================
# GOOGLE OAUTH 2.0 CREDENTIALS
# Configure at: https://console.cloud.google.com/apis/credentials
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match Authorized Redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-nexora-api.onrender.com/auth/google/callback

# ============================================================
# AI MODEL PROVIDER CREDENTIALS (Configure at least one)
# ============================================================
OPENROUTER_API_KEY=sk-or-v1-...
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
